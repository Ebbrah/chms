# Copy to /opt/chms/.env.production on the VM (chmod 600). Never commit real values.

# --- Single parish (on-prem) ---
DEPLOYMENT_MODE=single-parish
CHMS_PARISH_SLUG=klc

# Public API URL (must match Caddy api.chms.* → Kong)
NEXT_PUBLIC_SUPABASE_URL=https://api.chms.lutherankijitonyama.org
NEXT_PUBLIC_SUPABASE_ANON_KEY=<same anon key as Supabase Docker .env>

# Server-only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=<service_role key from Supabase Docker .env>

# WhatsApp OTP (same Meta app Ebenezer uses). Required for login once auth_mode=whatsapp.
# Copy the values from the live app's environment. Never commit the real token.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Optional: dedicated sender for login codes. If empty, OTP uses PHONE_NUMBER_ID above.
# META_WHATSAPP_OTP_PHONE_NUMBER_ID=
# Approved authentication template (required outside the 24h customer-care window).
# META_WHATSAPP_OTP_TEMPLATE_NAME=
# META_WHATSAPP_OTP_TEMPLATE_LANG=en
# SMS_...
